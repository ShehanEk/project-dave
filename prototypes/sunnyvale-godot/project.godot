[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="hero_body"
2d_physics/layer_3="enemy_body"
2d_physics/layer_4="hero_hurtbox"
2d_physics/layer_5="hittable"
2d_physics/layer_6="interactable"
2d_physics/layer_7="pickup"
2d_physics/layer_8="hazard"

[physics]

2d/default_gravity=0.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05490196, 0.09019608, 0.14901961, 1)
